{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "android: assembleDebug",
      "type": "shell",
      "command": "./gradlew :app:assembleDebug",
      "options": {
        "cwd": "${workspaceFolder}/android",
        "env": {
          "JAVA_HOME": "/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home"
        }
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "android: start emulator",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/android-emulator.sh",
        "ensure"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "android: install and launch",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/android-emulator.sh",
        "run"
      ],
      "dependsOn": ["android: assembleDebug", "android: start emulator"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
